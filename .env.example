# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# DeepSeek (required unless you pass --api-key or use another provider)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional provider keys (only if --llm openai|anthropic|google)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional defaults for the CLI flags (flags win over these)
# MAGENTO_MODEL=deepseek-chat
# MAGENTO_CDP_PORT=9222
# MAGENTO_HEADLESS=false
# MAGENTO_MAX_STEPS=40
# MAGENTO_TIMEOUT=900
# MAGENTO_SCREENSHOT_DIR=checkout_screenshots
# MAGENTO_OUTPUT=results.json
# MAGENTO_PROXY=
# MAGENTO_USER_AGENT=
# MAGENTO_COOKIES=
# MAGENTO_PROFILE_DIR=
# MAGENTO_CHANNEL=
